<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-lms">
	<select id="getStudentList" resultType="lx.edu.vo.StudentInfo">
		select student_id
			,student_name
			,gender
			,total_credits
			,birth_date
			,address
			,current_grade
			from students
	</select>
</mapper>