<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-project">
	<select id="findEmpByYear" parameterType="int" resultType="project.Emp">
		select employee_id as empId, department_id as deptId, first_name as firstName, last_name as lastName, DATE_FORMAT(hire_date, '%Y-%m-%d') hireDate, 
		email, salary from employees where year(hire_date) = #{year}
	</select>
	<select id="findEmpByDeptId" parameterType="int" resultType="project.Emp">
		select employee_id as empId, department_id as deptId, first_name as firstName, Last_name as lastName, DATE_FORMAT(hire_date, '%Y-%m-%d') hireDate,
		 email, salary from employees where department_id = #{deptId}
	</select>
	<select id="printStat" resultType="project.Emp">
		select d.department_name dname, round(avg(salary), -2) avs, max(salary) maxs, min(salary) mins
				from employees e join departments d
				on e.department_id = d.department_id
				group by  d.department_name, e.department_id
				order by e.department_id
	</select>
</mapper>