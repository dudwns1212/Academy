<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-requestlog">
	<insert id="insertLOG" parameterType="lx.edu.springmvc.vo.RequestLogVO" >
		insert request_log(
			req_class, req_method, req_time as current_timestamp) values(
			#{reqClass}, #{reqMethod}, current_timestmap)
	</insert>
</mapper>
