package myjdbc;
//변수와 객체를 구분하자!
public class VariableObject {
	public static void main(String[] args) {
		Product product = new Product(); 
		Product product2 = new Product();
		product2.price = 5000;
		System.out.println(product.price);
	}
}

class Product {
	int price;
	String name;
	String maker;
}