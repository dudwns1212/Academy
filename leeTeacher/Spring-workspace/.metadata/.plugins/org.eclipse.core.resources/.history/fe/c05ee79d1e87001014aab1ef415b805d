
public class aaa {
	public int[] solution(int[] num_list) {
        int lastIndex = num_list.length-1; 
        int lastNum = num_list[lastIndex];
        int num = num_list[lastIndex-1];
        if(lastNum > num) {
        	int input = lastNum - num;
        	num_list[lastIndex+1] = input;
        	return num_list;
        } else {
        	int input = lastNum * 2;
        	num_list[lastIndex+1] = input;
        	return num_list
        }
    }
}
