package project;

import java.util.ArrayList;
import java.util.List;

import org.springframework.context.ApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;

public interface EmpService {

	public List<Emp> findEmpByYear(int year) throws Exception;
	
	public List<Emp> findEmpByDeptId(int deptId) throws Exception;
	
	public EmpService getConnection() {
		ApplicationContext context = new ClassPathXmlApplicationContext("spring-project.xml");
		EmpService service = context.getBean(EmpService.class);
		
		return service;
	}
	
}
