package lx.edu.springmvc.aop;

import java.util.Date;

import org.aspectj.lang.JoinPoint;

import org.aspectj.lang.annotation.Aspect;
import org.aspectj.lang.annotation.Before;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.EnableAspectJAutoProxy;
import org.springframework.stereotype.Component;

import lx.edu.springmvc.dao.RequestLogDAO;
import lx.edu.springmvc.vo.AddrBookVO;
import lx.edu.springmvc.vo.RequestLogVO;

@Aspect
@Component
@EnableAspectJAutoProxy
public class RequestLogAdvice {
	
	@Autowired
	RequestLogDAO dao;
	
	@Autowired
	RequestLogVO vo;
	
	Date date = new Date();
	
	@Before("execution(* lx.edu.springmvc.controller.Addr*.*(..))")
	public void beforeLog(JoinPoint joinPoint) throws Exception {
		String reqClass = joinPoint.getTarget().getClass().getName();
		String reqMethod = joinPoint.getSignature().getName();
		String reqTime = 
		System.out.printf("class=%s, method=%s\n", reqClass, reqMethod);
		vo.setReqClass(reqClass);
		vo.setReqMethod(reqMethod);
		dao.insertLOG(vo);
		
	}
}
