import java.util.ArrayList;
import java.util.List;

public class aaa {
	public int solution(int n, String control) {
        int sum = 0;
        for(char a : control.toCharArray()) {
            if(a == 'w'){
                sum = n+1;
            } else if(a == 's'){
                sum = n-1;
            } else if(a == 'd') {
                sum = n+10;
            } else if(a == 'a') {
                sum = n-10;
            }
            
        }
        return sum;
    }
}
