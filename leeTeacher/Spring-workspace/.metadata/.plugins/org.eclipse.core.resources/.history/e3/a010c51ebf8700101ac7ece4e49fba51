<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-emp">
	<select id="findEmpByYear" parameterType="String" resultType="myspring.Emp">
		select employee_id, department_id, first_name, last_name, DATE_FORMAT(hire_date, '%Y-%m-%d') hd, email, salary"
				+ " from employees where year(hire_date) = #{year}
	</select>
</mapper>