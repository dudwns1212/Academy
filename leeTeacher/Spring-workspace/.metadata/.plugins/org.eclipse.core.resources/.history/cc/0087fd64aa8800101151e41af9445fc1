package lx.edu.springmvc;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.RequestMapping;

import jakarta.servlet.http.HttpServletRequest;

@Controller
public class AddrBookController {

	@Autowired
	AddrBookDAO dao;
	
	@RequestMapping("/addrbook_form.do")
	public String form() {
		return "addrbook_form";
	}
	
	@RequestMapping("/addrbook_list.do")
	public String list(HttpServletRequest req) throws Exception {
		List<AddrBookVO> list = dao.getDBList();
		req.setAttribute("data", list);
		return "addrbook_list";
	}
	
	@RequestMapping("/insert.do")
	public String insert(AddrBookVO vo) throws Exception {
		dao.insertDB(vo);
		return "redirect:/addrbook_list.do";
	}
	
	@RequestMapping("/edit.do")
	public String edit(HttpServletRequest req) throws Exception {
		int abId = Integer.parseInt(req.getParameter("ab_id"));
		System.out.println(abId);
		AddrBookVO ab = new AddrBookVO();
		ab = dao.getDB(abId);
		return "addrbook_edit_form";
	}
	
	@RequestMapping("/modify.do")
	public String modify() throws Exception { 
		return "redirect:/addrbook_list_form";
	}
	
}
