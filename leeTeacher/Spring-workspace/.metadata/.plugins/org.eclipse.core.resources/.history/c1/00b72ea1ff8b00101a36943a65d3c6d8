import java.util.*;
import java.util.Comparator;
import java.util.Scanner;

public class aaa {
	public static void main(String[] args) {
		int[] bandage = { 5, 1, 5 };
		int health = 30;
		int[][] attacks = { { 2, 10 }, { 9, 15 }, { 10, 5 }, { 11, 5 } };

		int answer = -1;
		int lastTime = attacks[attacks.length - 1][0];
		int t = bandage[0];
		int x = bandage[1];
		int y = bandage[2];
		int dhealth = health;
		boolean success = false;
		int hCount = 0;
		int aCount = 0;
		for (int i = 0; i <= lastTime; i++) {
			if (i == attacks[aCount][0]) {
				dhealth = dhealth - attacks[i][1];
				aCount++;
				hCount = 0;
				System.out.println(aCount + "번째 공격 : " + dhealth);
			} else if (dhealth < health) {
				if (hCount == t) {
					dhealth += x + y;
					hCount = 0;
					System.out.println(i + "초, 성공 : " + hCount + ", 피 상태 : " + dhealth);
				} else {
					dhealth += x;
					hCount++;
					System.out.println(i + "초, 성공횟수 : " + hCount + ", 피 상태 : " + dhealth);
				}

				if (dhealth <= 0) {
					System.out.println(dhealth);
					return;
				}

			}

		}

		System.out.println(dhealth > 0 ? dhealth : answer);
	}
}
