import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import lx.edu.vo.StudentInfo;

@Component
public class LmsDAO {
	
	@Autowired
	SqlSession session;
	
	public List<StudentInfo> getStudentInfoById() {
